@model ms_notification.DTOs.Email.ResignationData
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" content="width=device-width, initial-scale=1.0" name="viewport">
<style>
  @@media only screen and (max-width: 480px) {
    table { width: 100% !important; }
    h1 { font-size: 20px !important; }
    h2 { font-size: 18px !important; }
    p  { font-size: 14px !important; line-height: 1.4 !important; }
    td { padding: 15px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background-color:#F4F3FF;font-family:Arial,Helvetica,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0"
           style="background-color:#F4F3FF;padding:40px 0;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0"
                       style="background:#ffffff;border-radius:10px;overflow:hidden;
                              box-shadow:0 8px 20px rgba(0,0,0,0.05);">
                    <tr>
                        <td align="center" style="background:#A29BFE;padding:25px;">
                            <h1 style="color:#ffffff;margin:0;font-size:24px;">
                                Fin de collaboration
                            </h1>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:40px 30px;">
                            <h2 style="color:#333;margin-top:0;">
                                Cher(e) @Model.EmployeeFullName,
                            </h2>
                            <p style="color:#555;font-size:16px;line-height:1.6;">
                                Nous vous informons que votre collaboration avec
                                <strong style="color:#6C63FF;">@Model.CompanyName</strong>
                                prendra fin le
                                <strong style="color:#6C63FF;">@Model.ResignationDate</strong>.
                            </p>
                            <p style="color:#555;font-size:16px;line-height:1.6;">
                                Nous tenons à vous remercier sincèrement pour votre
                                engagement, votre professionnalisme et la qualité de
                                votre travail tout au long de votre parcours au sein
                                de notre équipe.
                            </p>
                            <p style="color:#555;font-size:16px;line-height:1.6;">
                                Nous vous souhaitons le meilleur pour la suite de
                                votre carrière et vos projets futurs.
                            </p>
                            <table width="100%" cellpadding="0" cellspacing="0"
                                   style="margin:30px 0;background:#F4F3FF;border-radius:8px;">
                                <tr>
                                    <td style="padding:16px 24px;">
                                        <p style="margin:0;color:#555;font-size:15px;">
                                            Cordialement,
                                        </p>
                                        <p style="margin:6px 0 0;color:#6C63FF;
                                                  font-size:15px;font-weight:bold;">
                                            L'équipe RH — @Model.CompanyName
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="center"
                            style="background:#F4F3FF;padding:20px;font-size:12px;color:#888;">
                            © 2026 @Model.CompanyName. Tous droits réservés.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>