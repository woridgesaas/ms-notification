<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" charset="UTF-8">
    <title>Absence non justifiée — Woridge</title>
    <style>
          @@media only screen and (max-width: 480px) {
            table { width: 100% !important; }
            h1 { font-size: 20px !important; }
            h2 { font-size: 18px !important; }
            p  { font-size: 14px !important; line-height: 1.4 !important; }
            td { padding: 15px !important; }
          }
</style>
</head>
<body style="margin:0;padding:0;background-color:#F4F3FF;font-family:Arial,Helvetica,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F4F3FF;padding:40px 0;">
        <tr>
            <td align="center">

                <table width="600" cellpadding="0" cellspacing="0"
                       style="background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 8px 20px rgba(0,0,0,0.05);">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background:#A29BFE;padding:25px;">
                            <h1 style="color:#ffffff;margin:0;font-size:24px;">Absence non justifiée</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td align="center" style="padding:40px 30px;">

                            <h2 style="color:#333;margin-top:0;">
                                Bonjour @Model.EmployeeFullName,
                            </h2>

                            <p style="color:#555;font-size:16px;">
                                Nous avons constaté votre absence non justifiée.
                            </p>

                            <!-- Absence Info Box -->
                            <table width="100%" cellpadding="0" cellspacing="0"
                                   style="background:#F4F3FF;border-radius:8px;margin:30px 0;padding:20px;">
                                <tr>
                                    <td style="color:#333;font-size:14px;">
                                        <p><strong>Date d'absence :</strong> @Model.AbsenceDate</p>
                                        <p><strong>Jours consécutifs :</strong> @Model.ConsecutiveDays jour(s)</p>
                                    </td>
                                </tr>
                            </table>

                            <p style="color:#555;font-size:16px;">
                                Veuillez soumettre votre justificatif dans les plus brefs délais
                                afin de régulariser votre situation.
                            </p>

                            <p style="color:#777;font-size:14px;">
                                Sans justificatif dans le délai imparti, votre absence sera
                                considérée comme non justifiée définitivement.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background:#F4F3FF;padding:20px;font-size:12px;color:#888;">
                            © 2026 Woridge. Tous droits réservés.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>