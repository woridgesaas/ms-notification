@model ms_notification.Messaging.Events.ContractGeneratedEvent

<style>
    @@media only screen and (max-width: 480px) {
        h1 { font-size: 20px !important; }
        p  { font-size: 14px !important; }
    }
</style>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Votre contrat Woridge</title>
</head>
<body style="margin:0;padding:0;background-color:#F4F3FF;font-family:Arial,Helvetica,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#F4F3FF;padding:40px 0;">
        <tr>
            <td align="center">
                <table width="100%" cellpadding="0" cellspacing="0"
                       style="background:#ffffff;border-radius:10px;overflow:hidden;
                              box-shadow:0 8px 20px rgba(0,0,0,0.05);max-width:600px;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background:#A29BFE;padding:25px;">
                            <h1 style="color:#ffffff;margin:0;font-size:24px;">
                                Votre contrat est prêt
                            </h1>
                        </td>
                    </tr>

                    <!-- Intro -->
                    <tr>
                        <td style="padding:40px 30px 20px 30px;">
                            <h2 style="color:#333;margin-top:0;">
                                Bonjour @Model.CandidateName,
                            </h2>
                            <p style="color:#555;font-size:16px;">
                                Votre contrat a été généré le
                                <strong>@Model.GeneratedAt.ToString("dd/MM/yyyy à HH:mm")</strong>.
                                Veuillez en prendre connaissance ci-dessous.
                            </p>
                        </td>
                    </tr>

                    <!-- Contenu du contrat -->
                    <tr>
                        <td style="padding:0 30px 30px 30px;">
                            <table width="100%" cellpadding="0" cellspacing="0"
                                   style="background:#F4F3FF;border-radius:8px;
                                          padding:25px;border-left:4px solid #A29BFE;">
                                <tr>
                                    <td style="color:#333;font-size:14px;line-height:1.6;">
                                        @Raw(Model.ContractHtml)
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Note -->
                    <tr>
                        <td style="padding:0 30px 30px 30px;">
                            <p style="color:#777;font-size:13px;">
                                Pour toute question, contactez votre responsable RH.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="background:#F4F3FF;padding:20px;font-size:12px;color:#888;">
                            © 2026 Woridge. Tous droits réservés.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>