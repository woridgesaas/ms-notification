{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST},${MSSQL_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${MSSQL_PASSWORD};TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev/ms-notify_dev-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "SmtpSettings": {
    "Server": "${SMTP_SERVER}",
    "Port": "${SMTP_PORT}",
    "SenderName": "Woridge System",
    "SenderEmail": "${SMTP_SENDER_EMAIL}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}"
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "AuthClient",
    "Key": "N2l7g7l4HcZdwXMBF2cCOP/sLBh5flmgz9l/l49lajoKExdUuoWchfA7U+NTeEnFHf9bwPQUTw/VZX0dr947nw=="
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]

  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "imane",
    "Password": "imane123",
    "Exchange": "woridge.exchange",
    "Queues": {
      "UserCreated": "user.created.queue",
      "ResignationCreated": "resignation.notification.queue"
    },
    "RoutingKeys": {
      "UserCreated": "user.created",
      "ResignationCreated": "resignation.created"
    }
  }

}

