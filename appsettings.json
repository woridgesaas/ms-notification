{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST},${MSSQL_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${MSSQL_PASSWORD};TrustServerCertificate=True"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev/ms-notify_dev-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },

  "SmtpSettings": {
    "Server": "${SMTP_SERVER}",
    "Port": "${SMTP_PORT}",
    "SenderName": "Woridge System",
    "SenderEmail": "${SMTP_SENDER_EMAIL}",
    "Username": "${SMTP_USERNAME}",
    "Password": "${SMTP_PASSWORD}",
    "UseSsl": "${SMTP_USE_SSL}"
  },

  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "woridge-authentication",
    "Audience": "woridge-frontend"
  },

  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },

   "RabbitMQ": {
    "Host": "${RABBITMQ_HOST}",
    "Port": "${RABBITMQ_PORT}",
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}",
    "Exchange": "woridge.exchange",
    "Queues": {
      "UserCreated": "notification.user.created.queue",
      "UserSyncCreated": "user.created.queue",
      "ResignationCreated": "resignation.notification.queue",
      "AbsenceAlertRh": "notification.absence.alert.rh.queue",
      "AbsenceAlertCeo": "notification.absence.alert.ceo.queue",
      "OvertimeHandleAlert": "notification.overtime.process.employee.queue",
      "LeaveHandleAlert": "notification.leave.processed.approve.queue",
      "ChangePasswordOtp": "notification.change-password.queue",
      "InterviewCreated": "interview.created.notification.queue",
      "InterviewStatusChanged": "interview.status.changed.notification.queue",
      "EvaluationSubmitted": "evaluation.submitted.notification.queue",
      "DocumentRequestCreated": "document.request.created.queue",
      "TenantReady": "q.notification.provisioning",
      "ContractGenerated": "contract.generated"

    },
    "RoutingKeys": {
      "UserCreated": "notification.user.created",
      "UserSyncCreated": "user.created",
      "ResignationCreated": "resignation.created",
      "AbsenceAlertRh": "notification.absence.alert.rh",
      "AbsenceAlertCeo": "notification.absence.alert.ceo",
      "OvertimeProcessedAlert": "overtime.processed.alert",
      "LeaveProcessedAlert": "leave.processed.alert",
      "ChangePasswordOtp": "notification.change-password",
      "InterviewCreated": "interview.created",
      "InterviewStatusChanged": "interview.status.changed",
      "EvaluationSubmitted": "evaluation.submitted",
      "DocumentRequestCreated": "document.request.created",
      "TenantReady": "tenant.ready.ms-notif"

    }
  }
}
